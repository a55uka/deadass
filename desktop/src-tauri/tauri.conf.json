{
  "$schema": "../gen/schemas/config-schema.json",
  "productName": "Deadass Companion",
  "version": "0.1.0",
  "identifier": "app.deadass.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Deadass Companion",
        "width": 900,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
